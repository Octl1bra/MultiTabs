{
  "manifest_version": 3,
  "name": "mt-spike-m0",
  "version": "0.0.1",
  "minimum_chrome_version": "132",
  "permissions": ["declarativeNetRequest", "webRequest", "cookies", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["patch.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
